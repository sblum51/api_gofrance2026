# Modèle de configuration runtime gofrance-api — à compléter sur le serveur.
# `castor setup` le dépose en ~/gofrance-api/.env.dist.
# Sur le serveur : cp -n .env.dist .env puis remplacer les CHANGE_ME.

APP_ENV=prod
APP_DEBUG=0
APP_SECRET=CHANGE_ME                      # openssl rand -hex 16
APP_SHARE_DIR=var/share

# Postgres partagé (réseau "backend", conteneur "database" de l'infra commune).
# PostGIS n'est pas nécessaire : les coordonnées sont stockées en flottants.
DATABASE_URL="postgresql://gofrance:CHANGE_ME@database:5432/gofrance?serverVersion=16&charset=utf8"

# JWT — clés montées en lecture seule depuis ~/gofrance-api/jwt/
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=CHANGE_ME
JWT_TOKEN_TTL=86400

# URL publique de l'API (génération d'URL hors contexte HTTP).
DEFAULT_URI=https://api.go-france.net

# Lien vers le back-office, utilisé dans les courriels transactionnels.
MANAGER_APP_URL=https://manager.go-france.net

# CORS : le joker couvre tous les sous-domaines d'organisation
# (reims.go-france.net, demo.go-france.net…) plus manager.go-france.net.
CORS_ALLOW_ORIGIN='^https://([a-z0-9-]+\.)?go-france\.net$'

MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
MAILER_DSN=null://null
MAILER_FROM_ADDRESS=no-reply@go-france.net

# Clé DATAtourisme (proxy de recherche de points d'intérêt).
DATATOURISME_API_KEY=CHANGE_ME

# Réglages FrankenPHP (optionnels).
# FRANKENPHP_NUM_WORKERS=4
# FRANKENPHP_NUM_THREADS=8

# Stockage S3 diffusé par CloudFront sur cdn.go-france.net.
# Clé et secret : utilisateur IAM « gofrance » (aws-create-user.sh).
# Le secret se renseigne BRUT ici, contrairement au MAILER_DSN qui l'exige
# encodé pour l'URL.
AWS_S3_REGION=eu-west-3
AWS_S3_BUCKET=cdn-gofrance
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME

